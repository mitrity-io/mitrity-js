{
  "name": "@mitrity/sdk",
  "version": "0.1.0",
  "description": "MITRITY governance adapter for TypeScript and JavaScript agents: Claude Agent SDK integration for the MITRITY edge (admission API and gateway).",
  "license": "Apache-2.0",
  "author": "MITRITY AB <hello@mitrity.com>",
  "homepage": "https://mitrity.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitrity-io/mitrity-js.git"
  },
  "bugs": {
    "url": "https://github.com/mitrity-io/mitrity-js/issues"
  },
  "keywords": [
    "mitrity",
    "governance",
    "agents",
    "claude-agent-sdk",
    "mcp"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "tsup": "^8.5.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
